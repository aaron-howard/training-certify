# Production Environment Configuration
# Copy to Vercel project env (Production) or .env.production — never commit real secrets.

# --- Required (app fails to start in production without these) ---

# Database
DATABASE_URL="postgresql://username:password@hostname:5432/database_name"

# Clerk Authentication (https://dashboard.clerk.com — use live keys in production)
CLERK_SECRET_KEY="sk_live_..."
VITE_CLERK_PUBLISHABLE_KEY="pk_live_..."

# Application
NODE_ENV="production"
PORT="3000"

# CSRF protection secret (generate with: openssl rand -base64 32) — REQUIRED in production
CSRF_SECRET="your-random-32-character-secret-here"

# Vercel Blob — certification proof uploads (Vercel → Storage) — REQUIRED in production
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# --- Strongly recommended ---

# Sentry for error tracking (https://sentry.io)
SENTRY_DSN="https://...@sentry.io/..."
# Defaults to 0.1 in production when unset (see src/lib/sentry.server.ts)
# SENTRY_TRACES_SAMPLE_RATE="0.1"
# SENTRY_PROFILES_SAMPLE_RATE="0.1"
# SENTRY_ENVIRONMENT="production"

# Protect /metrics and deep /health (Bearer or X-Internal-Ops-Token). Min 16 chars.
# Generate with: openssl rand -hex 16
INTERNAL_OPS_TOKEN="your-internal-ops-token-here"

# Force HTTPS redirects (platform TLS still applies on Vercel)
HTTPS_ONLY="true"

# --- Optional ---

# Redis is documented for future multi-instance cache; not wired in app code yet.
# REDIS_URL="redis://hostname:6379"

# Rate limiting (serverless / multi-instance)
# Default in production: Postgres-backed (shared across all instances). Set to false only for debugging.
# USE_DB_RATE_LIMIT="false"

# Logging
# LOG_LEVEL="info"

# Performance
# DB_POOL_SIZE="10"
# CACHE_TTL_SECONDS="300"
