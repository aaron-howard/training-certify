{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/entry-client.tsx",
    "src/entry-server.tsx",
    "src/start.ts",
    "src/routes/**/*.{ts,tsx}",
    "src/router.tsx",
    "src/routeTree.gen.ts",
    "scripts/**/*.{ts,js,mjs,sh}",
    "e2e/**/*.{ts,tsx}",
    "perf/**/*.{js,ts}",
    "vite.config.ts",
    "app.config.ts",
    "drizzle.config.ts",
    "playwright.config.ts",
    "vitest.config.ts",
    "eslint.config.js",
    "prettier.config.js",
    "src/db/seed.ts"
  ],
  "ignorePatterns": [
    "product/**",
    "product-plan/**",
    "docs/api-jsdoc/**",
    "data/**",
    "drizzle/**",
    "**/*.md",
    "fallow-results.json",
    "lint-results.json",
    "npm-audit-results.json"
  ],
  "ignoreDependencies": [
    "typescript-native",
    "@tanstack/react-router-ssr-query",
    "@tailwindcss/vite",
    "nitro",
    "@clerk/testing",
    "dotenv"
  ],
  "ignoreExports": [
    {
      "file": "src/lib/logging.client-stub.ts",
      "exports": ["*"]
    },
    {
      "file": "src/lib/logging.server.ts",
      "exports": ["*"]
    },
    {
      "file": "src/lib/sentry.server.ts",
      "exports": ["*"]
    },
    {
      "file": "src/lib/monitoring.server.ts",
      "exports": ["*"]
    },
    {
      "file": "src/components/pages/CatalogRoutePage.tsx",
      "exports": ["CatalogRoutePage"]
    },
    {
      "file": "src/components/pages/CertificationManagementRoutePage.tsx",
      "exports": ["CertificationManagementRoutePage"]
    },
    {
      "file": "src/components/pages/TeamManagementRoutePage.tsx",
      "exports": ["TeamManagementRoutePage"]
    },
    {
      "file": "src/types/index.ts",
      "exports": ["*"]
    },
    {
      "file": "src/start.ts",
      "exports": ["*"]
    }
  ],
  "duplicates": {
    "minOccurrences": 3,
    "ignore": ["docs/api-jsdoc/**", "product-plan/**", "product/**"]
  },
  "rules": {
    "unused-dependencies": "warn"
  }
}
